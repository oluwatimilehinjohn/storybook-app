# Local development: copy to config/config.env and replace the placeholders.
# Render: configure values in your service's Environment settings instead.
# No config.env file is required on Render. Never commit real credentials.
NODE_ENV=development
# Optional locally (defaults to 3000). Let Render supply PORT in production.
PORT=3000
# MongoDB Atlas Connect > Drivers URI, with a database user and password.
# This local URI is for developers who run their own MongoDB server.
MONGO_URI=mongodb://127.0.0.1:27017/storybooks
# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Web application.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Actual route: /auth + /google/callback. Register the exact URL in Google Cloud.
# Production: https://writeestoriess.onrender.com/auth/google/callback
# See config.env.production.example for the production settings.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep it stable across deployments; changing it invalidates existing sessions.
SESSION_SECRET=replace-with-a-long-random-secret
