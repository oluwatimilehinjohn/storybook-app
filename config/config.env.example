# Copy to config/config.env for local development. Never commit real credentials.
# On your hosting provider, configure these as environment variables instead.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/storybooks
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Must exactly match an authorized redirect URI in your Google OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret
