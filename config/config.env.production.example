# Reference for the existing writeestoriess Render service's Environment settings.
# Do not commit a populated copy. This file is not loaded automatically.
NODE_ENV=production
# Render supplies PORT. The repository selects Node 22 and npm.
MONGO_URI=replace-with-your-existing-mongodb-connection-string
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Register this exact URI on the same OAuth client in Google Cloud.
GOOGLE_CALLBACK_URL=https://writeestoriess.onrender.com/auth/google/callback
# Generate once and keep stable across deployments.
SESSION_SECRET=replace-with-a-long-random-secret
