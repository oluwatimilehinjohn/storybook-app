<section class="error-state">
    <span class="eyebrow">Sign-in interrupted</span>
    <span class="empty-icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span>
    <h1>We couldn’t finish signing you in.</h1>
    <p>Please start a fresh sign-in from the button below.<br>If this happens again, the site owner will need to check the sign-in service.</p>
    <div class="button-row"><a href="/auth/google" class="button button-primary">Try Google sign-in again</a><a href="/" class="button button-secondary">Back to home</a></div>
    {{> _error_reference}}
</section>
