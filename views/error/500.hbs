<section class="error-state"><span class="eyebrow">Error {{#if errorStatus}}{{errorStatus}}{{else}}500{{/if}}</span><span class="empty-icon"><i class="fa-solid fa-cloud" aria-hidden="true"></i></span><h1>A pause in the story.</h1><p>We couldn’t complete that request. Please try again in a moment.<br>If you were writing, go back to check your words before trying to save again.</p><a href="{{#if user}}/dashboard{{else}}/{{/if}}" class="button button-primary">{{#if user}}Back to my stories{{else}}Back to home{{/if}}</a>{{> _error_reference}}</section>
