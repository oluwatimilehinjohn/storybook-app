<header class="site-header">
    <div class="header-inner">
        <a href="{{#if user}}/dashboard{{else}}/{{/if}}" class="brand" aria-label="Storybooks home"><span class="brand-mark"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>storybooks<span class="brand-dot">.</span></a>
        {{#if user}}
        <nav class="primary-nav" aria-label="Main navigation">
            <a href="/dashboard" {{#if (eq activeNav 'dashboard')}}aria-current="page"{{/if}}><i class="fa-regular fa-bookmark" aria-hidden="true"></i> My stories</a>
            <a href="/stories" {{#if (eq activeNav 'stories')}}aria-current="page"{{/if}}><i class="fa-regular fa-compass" aria-hidden="true"></i> Discover</a>
        </nav>
        <div class="header-actions">
            {{> _add_btn}}
            <details class="account-menu">
                <summary aria-label="Your account"><span class="avatar">{{#if user.image}}<img src="{{user.image}}" alt="" referrerpolicy="no-referrer">{{else}}<i class="fa-regular fa-user" aria-hidden="true"></i>{{/if}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
                <div class="account-popover"><span class="eyebrow">Signed in as</span><strong>{{user.displayName}}</strong><a href="/auth/logout"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sign out</a></div>
            </details>
        </div>
        {{else}}<a class="button button-primary" href="/auth/google">Sign in</a>{{/if}}
    </div>
</header>
