<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#214e40">
    <title>{{#if pageTitle}}{{pageTitle}} · {{/if}}Storybooks</title>
    {{> _styles}}
    <script src="{{assets.app}}" data-editor-src="{{assets.editor}}" defer></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {{> _header}}
    <main id="main-content" class="site-main" tabindex="-1">
        {{#if notice}}<div class="notice" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> {{notice}}</div>{{/if}}
        {{{body}}}
    </main>
    {{> _footer}}
    <dialog id="delete-dialog" class="confirmation-dialog" aria-labelledby="delete-heading" aria-describedby="delete-description">
        <div class="dialog-symbol"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></div>
        <h2 id="delete-heading">Delete this story?</h2>
        <p id="delete-description">“<span data-delete-title></span>” will be permanently deleted. This cannot be undone.</p>
        <div class="button-row"><button type="button" class="button button-secondary" data-close-dialog autofocus>Keep story</button><button type="button" class="button button-danger" data-confirm-delete>Delete story</button></div>
    </dialog>
</body>
</html>
